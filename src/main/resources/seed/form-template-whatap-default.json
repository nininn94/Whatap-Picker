{
  "version": 1,
  "title": "WhaTap 설문 이벤트",
  "subtitle": "본 설문은 데이터의 신뢰성을 위해 중복 참여, 허위 정보 입력, 또는 문항을 읽지 않은 불성실 응답으로 판단될 경우 경품 발송 대상에서 제외될 수 있음을 안내드립니다.",
  "pages": [
    {
      "id": "common-1",
      "title": "기본 정보",
      "fields": [
        { "key": "lastName",  "type": "TEXT",  "label": "성",       "required": true },
        { "key": "firstName", "type": "TEXT",  "label": "이름",     "required": true },
        { "key": "company",   "type": "TEXT",  "label": "회사명",   "required": true },
        { "key": "email",     "type": "EMAIL", "label": "회사 이메일", "required": true,
          "helper": "경품은 기입하신 비즈니스 이메일을 통해 본인 확인 후 발송됩니다. (gmail, naver, kakao 등 개인 이메일 기재 시 당첨 제외)",
          "validation": "COMPANY_EMAIL_IF_NOT_STUDENT_FREELANCER" },
        { "key": "phone",     "type": "PHONE", "label": "핸드폰 번호", "required": true,
          "pattern": "^010[1-9]\\d{7}$",
          "helper": "경품 발송을 위해 정확히 적어주세요. (010 + 8자리, 010 뒤 첫 자리는 0이 될 수 없습니다.)" },
        { "key": "industry",           "type": "SELECT", "label": "산업군",   "required": true, "optionsRef": "INDUSTRY" },
        { "key": "jobFunction",        "type": "SELECT", "label": "직무",     "required": true, "optionsRef": "JOB_FUNCTION" },
        { "key": "jobLevel",           "type": "SELECT", "label": "직급",     "required": true, "optionsRef": "JOB_LEVEL" },
        { "key": "companySize",        "type": "SELECT", "label": "기업 규모", "required": true, "optionsRef": "COMPANY_SIZE" },
        { "key": "employeeCountRange", "type": "SELECT", "label": "직원 수",   "required": true, "optionsRef": "EMPLOYEE_COUNT_RANGE" },
        { "key": "monitoringStatus",   "type": "RADIO",  "label": "현재 모니터링을 사용하고 계신가요?", "required": true, "optionsRef": "MONITORING_STATUS" }
      ],
      "branching": [
        { "when": { "monitoringStatus": "USING_WHATAP" }, "goTo": "whatap" },
        { "when": { "monitoringStatus": "USING_OTHER"  }, "goTo": "other" },
        { "when": { "monitoringStatus": "NOT_USING"    }, "goTo": "not-using" }
      ]
    },
    {
      "id": "whatap",
      "title": "와탭 사용 중",
      "fields": [
        { "key": "surveyPayload.whatap.proficiency",
          "type": "SCALE_1_10",
          "label": "와탭을 얼마나 잘 사용하고 계신가요?",
          "required": true,
          "scaleLowLabel": "사용에 어려움을 겪고 있다",
          "scaleHighLabel": "매우 잘 사용하고 있다" },
        { "key": "surveyPayload.whatap.neededHelps",
          "type": "CHECKBOX_MULTI",
          "label": "와탭을 잘 사용하기 위해서 어떤 도움이 필요하다고 생각하시나요?",
          "options": [
            { "value": "USER_EDUCATION",      "label": "사용자교육" },
            { "value": "NEW_FEATURE_INTRO",   "label": "신규 기능 소개" },
            { "value": "EXTRA_PRODUCT_INTRO", "label": "추가 제품 소개" },
            { "value": "OTHER",               "label": "기타" }
          ] }
      ],
      "branching": [ { "goTo": "common-7" } ]
    },
    {
      "id": "other",
      "title": "사용 중인 모니터링",
      "fields": [
        { "key": "surveyPayload.other.commercialProducts",
          "type": "CHECKBOX_MULTI",
          "label": "어떤 모니터링을 사용하고 계신가요? (복수선택 가능)",
          "required": true,
          "options": [
            { "value": "DATADOG",      "label": "데이터독 (Datadog)" },
            { "value": "NEW_RELIC",    "label": "뉴렐릭 (New Relic)" },
            { "value": "DYNATRACE",    "label": "다이나트레이스 (Dynatrace)" },
            { "value": "APP_DYNAMICS", "label": "앱다이나믹스 (AppDynamics / 시스코)" },
            { "value": "SPLUNK",       "label": "스플렁크 (Splunk)" },
            { "value": "ELASTIC",      "label": "엘라스틱 (Elastic)" },
            { "value": "SENTRY",       "label": "센트리 (Sentry)" },
            { "value": "EXEM",         "label": "엑셈 (Exem / 인터맥스)" },
            { "value": "JENNIFER",     "label": "제니퍼소프트 (Jeniffer)" },
            { "value": "WATCHTEK",     "label": "와치텍 (WatchTek / 와치올)" },
            { "value": "ZENIUS",       "label": "브레인즈컴퍼니 (Zenius)" },
            { "value": "NKIA",         "label": "엔키아 (NKIA / 폴스타)" },
            { "value": "OPEN_SOURCE",  "label": "오픈소스 사용 중" },
            { "value": "OTHER",        "label": "기타" }
          ] },
        { "key": "surveyPayload.other.commercialOther",
          "type": "LONG_ANSWER",
          "label": "사용하고 계신 상용 모니터링 제품을 작성해 주세요.",
          "showWhen": { "surveyPayload.other.commercialProducts": { "contains": "OTHER" } } },
        { "key": "surveyPayload.other.openSourceProducts",
          "type": "CHECKBOX_MULTI",
          "label": "어떤 오픈소스 모니터링을 사용하고 계신가요? (복수선택 가능)",
          "required": true,
          "showWhen": { "surveyPayload.other.commercialProducts": { "contains": "OPEN_SOURCE" } },
          "options": [
            { "value": "ZABBIX",     "label": "자빅스 (Zabbix / 오픈소스)" },
            { "value": "PROMETHEUS", "label": "프로메테우스 (Prometheus / 오픈소스)" },
            { "value": "GRAFANA",    "label": "그라파나 (Grafana / 오픈소스)" },
            { "value": "LOG4J",      "label": "아파치 로그포제이 (Log4j / 오픈소스 라이브러리)" },
            { "value": "OTHER",      "label": "기타" }
          ] },
        { "key": "surveyPayload.other.openSourceOther",
          "type": "LONG_ANSWER",
          "label": "사용하고 계신 오픈소스 모니터링을 작성해 주세요.",
          "showWhen": { "surveyPayload.other.openSourceProducts": { "contains": "OTHER" } } },

        { "key": "surveyPayload.other.commercial.deployment",
          "type": "RADIO", "label": "상용 모니터링을 어떤 방법으로 사용하고 계신가요?",
          "required": true,
          "showWhen": { "surveyPayload.other.commercialProducts": { "not_only": "OPEN_SOURCE" } },
          "options": [
            { "value": "PUBLIC_SAAS",  "label": "Public SaaS" },
            { "value": "PRIVATE_SAAS", "label": "Private SaaS (설치구독형)" },
            { "value": "ON_PREMISE",   "label": "On-premise (영구라이선스)" }
          ] },
        { "key": "surveyPayload.other.commercial.satisfaction",
          "type": "RADIO", "label": "현재 사용 중인 상용 모니터링에 대한 전반적인 만족도는 어느 정도인가요?",
          "required": true,
          "showWhen": { "surveyPayload.other.commercialProducts": { "not_only": "OPEN_SOURCE" } },
          "options": [
            { "value": "VERY_SATISFIED",    "label": "매우 만족" },
            { "value": "SATISFIED",         "label": "대체로 만족" },
            { "value": "NEUTRAL",           "label": "보통" },
            { "value": "DISSATISFIED",      "label": "대체로 불만족" },
            { "value": "VERY_DISSATISFIED", "label": "매우 불만족" }
          ] },
        { "key": "surveyPayload.other.commercial.complaints",
          "type": "CHECKBOX_MULTI", "label": "현재 사용하고 있는 상용 모니터링의 불만은 무엇인가요? (복수 선택 가능)",
          "required": true,
          "showWhen": { "surveyPayload.other.commercialProducts": { "not_only": "OPEN_SOURCE" } },
          "options": [
            { "value": "PERFORMANCE_LACK", "label": "성능 부족 / 기능 제한" },
            { "value": "USABILITY_LACK",   "label": "사용 편의성 부족" },
            { "value": "SUPPORT_LACK",     "label": "지원 서비스 부족" },
            { "value": "PRICE_BURDEN",     "label": "가격 부담" },
            { "value": "OTHER",            "label": "기타" }
          ] },
        { "key": "surveyPayload.other.commercial.annualBudget",
          "type": "RADIO", "label": "상용 모니터링 연간 예산은 어떻게 되나요?",
          "showWhen": { "surveyPayload.other.commercialProducts": { "not_only": "OPEN_SOURCE" } },
          "options": [
            { "value": "NONE",     "label": "예산 없음" },
            { "value": "LT_1M",    "label": "100만원 미만" },
            { "value": "M_1_5",    "label": "100만원 이상 ~ 500만원 미만" },
            { "value": "M_5_10",   "label": "500만원 이상 ~ 1천만원 미만" },
            { "value": "GTE_10M",  "label": "1,000만원 이상" },
            { "value": "UNKNOWN",  "label": "잘 모르겠다" }
          ] },
        { "key": "surveyPayload.other.commercial.switchReason",
          "type": "RADIO", "label": "상용 모니터링으로 교체한다면 가장 큰 이유는 무엇인가요?",
          "showWhen": { "surveyPayload.other.commercialProducts": { "not_only": "OPEN_SOURCE" } },
          "options": [
            { "value": "A_OPS_EFFICIENCY",     "label": "A. 운영 인력의 업무 효율화" },
            { "value": "B_TOOL_CONSOLIDATION", "label": "B. 산재된 모니터링 툴의 통합" },
            { "value": "C_ENTERPRISE_SLA",     "label": "C. 엔터프라이즈급 보안 및 안정적인 기술 지원(SLA) 필요" },
            { "value": "D_ADVANCED_FEATURES",  "label": "D. 오픈소스로 구현하기 힘든 고도화된 기능(AI 분석, 예측 등) 활용" }
          ] },

        { "key": "surveyPayload.other.openSource.deployment",
          "type": "CHECKBOX_MULTI", "label": "오픈소스 모니터링은 어떤 방식으로 운영 중이신가요? (복수 선택 가능)",
          "showWhen": { "surveyPayload.other.commercialProducts": { "contains": "OPEN_SOURCE" } },
          "options": [
            { "value": "ON_PREMISE",      "label": "자체 서버에 직접 설치 및 운영 (On-premise)" },
            { "value": "CLOUD_VM",        "label": "퍼블릭 클라우드 내 설치형 (Cloud VM)" },
            { "value": "MANAGED_SERVICE", "label": "매니지드 서비스 이용 (예: AWS Managed Prometheus 등)" },
            { "value": "MIXED",           "label": "여러 오픈소스를 조합하여 운영 (예: Prometheus + Grafana 등)" }
          ] },
        { "key": "surveyPayload.other.openSource.satisfaction",
          "type": "RADIO", "label": "현재 사용 중인 오픈소스 모니터링에 대한 전반적인 만족도는 어느 정도인가요?",
          "showWhen": { "surveyPayload.other.commercialProducts": { "contains": "OPEN_SOURCE" } },
          "options": [
            { "value": "VERY_SATISFIED",    "label": "매우 만족" },
            { "value": "SATISFIED",         "label": "대체로 만족" },
            { "value": "NEUTRAL",           "label": "보통" },
            { "value": "DISSATISFIED",      "label": "대체로 불만족" },
            { "value": "VERY_DISSATISFIED", "label": "매우 불만족" }
          ] },
        { "key": "surveyPayload.other.openSource.difficulties",
          "type": "CHECKBOX_MULTI", "label": "오픈소스 모니터링 사용 시 어려운 점은 무엇인가요? (복수 선택 가능)",
          "showWhen": { "surveyPayload.other.commercialProducts": { "contains": "OPEN_SOURCE" } },
          "options": [
            { "value": "INTEGRATION",            "label": "통합 관리의 부재" },
            { "value": "EXPERT_LACK",            "label": "전문 인력 부족" },
            { "value": "PERFORMANCE_SCALABILITY","label": "성능 및 확장성" },
            { "value": "SUPPORT_LACK",           "label": "기술 지원 부재" },
            { "value": "STAFFING_CONCERN",       "label": "인력에 대한 걱정 (퇴사, 교육의 어려움 등)" }
          ] }
